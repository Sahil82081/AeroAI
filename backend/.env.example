# ==============================================================================
# AeroAI: Agentic Flight Intelligence Platform - Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="AeroAI: Agentic Flight Intelligence Platform"
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./autonomous_recovery.db
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disruption_recovery
POSTGRES_PORT=5432

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Stage 6: Flight Provider Configuration (OpenSky Network / Aviationstack / Mock GDS)
FLIGHT_PROVIDER_MODE=auto
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AVIATIONSTACK_API_KEY=
FLIGHT_API_TIMEOUT_SECONDS=5.0

# Optional External LLM Integration
GEMINI_API_KEY=

# Event Bus & Streaming (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Travel Policy Knowledge Base & RAG Directories
POLICIES_RAW_DIR=data/policies/raw
POLICIES_DB_DIR=data/policies/vector_store
POLICIES_MANIFEST_PATH=data/policies/sources.json
POLICIES_INGESTION_MANIFEST=data/policies/ingestion_manifest.json

# Live News Feed Configuration (Google News RSS)
NEWS_FEED_URL=https://news.google.com/rss/search
NEWS_FEED_REGION=IN
NEWS_FEED_LANGUAGE=en-IN
NEWS_FEED_CEID=IN:en
NEWS_CACHE_TTL_SECONDS=900
NEWS_TIMEOUT_SECONDS=10.0
