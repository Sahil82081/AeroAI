# ==============================================================================
# AeroAI: Autonomous Disruption Recovery System - Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="AeroAI: Autonomous Disruption Recovery System"
ENVIRONMENT=development
DEBUG=True

# Security (Replace with strong random token in production)
SECRET_KEY=super-secret-production-grade-jwt-key-9876543210
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Used by docker-compose)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disruption_recovery
POSTGRES_PORT=5432

# Database URL:
# For local SQLite dev: sqlite:///./autonomous_recovery.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/disruption_recovery
DATABASE_URL=sqlite:///./autonomous_recovery.db

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Staged AI & Event Integrations
GEMINI_API_KEY=your_gemini_api_key_here
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Feature 1: Live News Feed (Google News RSS)
NEWS_FEED_URL=https://news.google.com/rss/search
NEWS_FEED_REGION=IN
NEWS_FEED_LANGUAGE=en-IN
NEWS_FEED_CEID=IN:en
NEWS_CACHE_TTL_SECONDS=900
NEWS_TIMEOUT_SECONDS=10.0

# Feature 2: Airline Policy Knowledge Base & RAG
POLICIES_RAW_DIR=data/policies/raw
POLICIES_DB_DIR=data/policies/chroma_db
POLICIES_MANIFEST_PATH=data/policies/sources.json
POLICIES_INGESTION_MANIFEST=data/policies/ingestion_manifest.json
