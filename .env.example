# ==============================================================================
# AeroAI: Agentic Flight Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="AeroAI: Agentic Flight Intelligence Platform"
ENVIRONMENT=development
DEBUG=True

# Security (Replace with a strong random secret key in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development with zero external dependencies:
DATABASE_URL=sqlite:///./autonomous_recovery.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disruption_recovery
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disruption_recovery
POSTGRES_PORT=5432

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Stage 6: Flight Provider Configuration (OpenSky Network / Aviationstack / Mock GDS)
# Modes: "auto" (attempts real providers with automatic mock fallback), "real" (strict live), "mock" (simulation)
FLIGHT_PROVIDER_MODE=auto
OPENSKY_USERNAME=your_opensky_username_optional
OPENSKY_PASSWORD=your_opensky_password_optional
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_optional
FLIGHT_API_TIMEOUT_SECONDS=5.0

# Optional External LLM Integration (Google Gemini API)
# AeroAI runs fully offline with deterministic neural vector embeddings and heuristic fallbacks.
# Provide a key to enable live Gemini multi-turn generation.
GEMINI_API_KEY=your_gemini_api_key_here

# Event Bus & Streaming (Apache Kafka)
# Defaults to in-memory Kafka broker simulator if external broker is absent
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Travel Policy Knowledge Base & RAG Directories
POLICIES_RAW_DIR=data/policies/raw
POLICIES_DB_DIR=data/policies/vector_store
POLICIES_MANIFEST_PATH=data/policies/sources.json
POLICIES_INGESTION_MANIFEST=data/policies/ingestion_manifest.json

# Live News Feed Configuration (Google News RSS)
NEWS_FEED_URL=https://news.google.com/rss/search
NEWS_FEED_REGION=IN
NEWS_FEED_LANGUAGE=en-IN
NEWS_FEED_CEID=IN:en
NEWS_CACHE_TTL_SECONDS=900
NEWS_TIMEOUT_SECONDS=10.0
